rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  FlowNote Cloud Storage 보안 규칙
//
//  배포: Firebase 콘솔 → Storage → 규칙 탭 → 붙여넣고 [게시]
//        또는  firebase deploy --only storage
//
//  `training_data_service.dart` 가 영수증 원본 이미지를 학습용으로 올린다.
// ════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 게스트(익명) 로그인인가. (#192)
    //
    // 🔴 익명 로그인도 `request.auth != null` 이라, "로그인했으면 통과"
    //    규칙은 게스트도 전부 통과시킨다. 공용 폴더는 막아야 한다.
    function isAnon() {
      return isSignedIn()
             && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isMember() {
      return isSignedIn() && !isAnon();
    }

    // 관리자 한 명.
    //
    // 🔴 `inquiry_service.dart` 의 `adminEmail`, `firestore.rules` 의
    //    `isAdmin()` 과 **세 곳이 모두 같은 주소**여야 한다.
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email == 'flownote.kr@gmail.com'
             && request.auth.token.email_verified == true;
    }

    // ── 학습용 영수증 이미지 ─────────────────────────────────
    //   🔴 실제 업로드 경로는 `receipts/{docId}.jpg` 이다.
    //      (training_data_service.dart `_uploadImage()` → _storage.ref('receipts/...'))
    //      경로를 training_data/ 로 적어두면 업로드가 전부 거부되므로 주의.
    //
    //   - 쓰기: 로그인 사용자, 10MB 이하 이미지만
    //   - 읽기: 업로드 직후 getDownloadURL() 을 호출하므로 로그인 사용자에게 허용
    //   🔴 게스트는 못 올린다(#192). 익명 계정은 얼마든지 새로 만들 수
    //      있어서, 열어 두면 공용 폴더가 쓰레기로 찬다. 게스트가 찍은
    //      영수증은 `users/{uid}/` 아래 자기 폴더에만 담긴다.
    match /receipts/{allPaths=**} {
      allow write: if isMember()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if isSignedIn();
    }

    // 과거 경로 호환 (혹시 training_data/ 로 올라간 파일이 있을 경우)
    match /training_data/{allPaths=**} {
      allow write: if isMember()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if isSignedIn();
    }

    // ── 사용자별 영수증 이미지 백업 ──────────────────────────
    //   경로: users/<uid>/receipts/r_<id>_<시각>.jpg
    //   (`receipt_image_upload_web.dart` 가 쓴다 — **웹에서만**.
    //    안드로이드/iOS 는 앱 문서 폴더에 두고 올리지 않는다)
    //
    //   🔴 게스트도 **자기 폴더**에는 쓸 수 있다(#192·#193). 웹에서 고른
    //      사진의 `blob:` URL 은 탭이 닫히면 죽어서, 여기 안 올리면
    //      체험으로 찍은 영수증이 새로고침 한 번에 회색 칸이 된다.
    //      남의 uid 아래는 여전히 못 본다.
    //
    //   🔴 게스트에게는 **파일 하나 5MB 이하·이미지만** 허용한다(#193).
    //      가입자는 예전처럼 제한이 없다. 익명 계정은 얼마든지 새로
    //      만들 수 있어서, 크기를 안 막으면 저장소를 채울 수 있다.
    match /users/{uid}/{allPaths=**} {
      allow read: if isOwnerUid(uid);
      allow write: if isOwnerUid(uid)
                   && (
                     isMember()
                     || (
                       request.resource.size < 5 * 1024 * 1024
                       && request.resource.contentType.matches('image/.*')
                     )
                   );
    }

    // ── 문의 첨부 사진 ───────────────────────────────────────
    //   경로: inquiries/<uid>/<문의id>/<순번>_<파일명>
    //
    //   - 쓰기: 본인 폴더에만. **사진만**, 5MB 이하.
    //     앱이 올리기 전에 긴 쪽 1600px / 약 1MB 로 줄이므로
    //     5MB 는 넉넉한 안전선이다. `InquiryService.maxFileBytes`
    //     와 **같은 값**이어야 한다 — 한쪽만 바꾸면 "앱은 통과시켰는데
    //     서버가 거부" 하는 혼란이 생긴다.
    //   - 읽기: 본인, 그리고 관리자.
    //     🔴 관리자가 못 읽으면 답변할 때 첨부 사진이 깨져 보인다.
    //     🔴 다른 사람은 링크를 알아도 열리지 않는다.
    //   - 삭제: 본인(글을 지울 때) 또는 관리자.
    //   🔴 게스트는 못 올린다(#192). 문의 글 자체를 `firestore.rules` 에서
    //      막았으므로 첨부도 같이 막는다. 한쪽만 열어 두면 주인 없는
    //      사진이 쌓인다.
    match /inquiries/{uid}/{allPaths=**} {
      allow write: if isOwnerUid(uid)
                   && isMember()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if isOwnerUid(uid) || isAdmin();
      allow delete: if isOwnerUid(uid) || isAdmin();
    }

    // ── 그 외 차단 ───────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
