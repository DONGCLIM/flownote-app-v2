rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  FlowNote Firestore 보안 규칙
//
//  ⚠️ 배포 방법 (둘 중 하나)
//   A) Firebase 콘솔 → Firestore Database → 규칙 탭 → 이 내용 붙여넣고 [게시]
//   B) CLI:  firebase deploy --only firestore:rules
//
//  ⚠️ 중요: `training_data` 컬렉션은 OCR 학습데이터 수집용으로
//     기존 앱이 **인증 없이도** 쓰고 있었다. 아래 규칙은 로그인 사용자에게만
//     쓰기를 허용하도록 조인다. (게스트 모드를 없앴으므로 항상 로그인 상태)
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 관리자 한 명.
    //
    // 🔴 `inquiry_service.dart` 의 `adminEmail` 과 **같은 주소**여야 한다.
    //    한쪽만 바꾸면 앱에는 답변 버튼이 보이는데 저장이 거부된다.
    //
    // 🔴 `email_verified` 를 같이 본다. 메일 주소만 보면, 확인되지 않은
    //    주소로 가입해 관리자 행세를 할 여지가 생긴다.
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email == 'flownote.kr@gmail.com'
             && request.auth.token.email_verified == true;
    }

    // ── 사용자 개인정보 ──────────────────────────────────────
    //   users/{uid}                  회원 정보 + 사업자 정보 + 동의 이력
    //   users/{uid}/receipts/{id}    영수증 클라우드 백업
    //   users/{uid}/consent_log/{id} 동의 이력 감사 로그 (append-only)
    //
    //   본인만 읽고 쓸 수 있다. 다른 사용자의 문서는 절대 접근 불가.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);   // 회원 탈퇴

      match /receipts/{receiptId} {
        allow read, write: if isOwner(uid);
      }

      // 동의 이력은 수정/삭제 금지 (법적 증빙) — 단, 탈퇴 시 삭제는 허용
      match /consent_log/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // 그 밖의 하위 컬렉션도 본인만
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── OCR 학습데이터 (기존 기능 유지) ──────────────────────
    //   training_data/{docId}
    //   `training_data_service.dart` 가 스캔 시점에 기록한다.
    //   - 생성/수정: 로그인 사용자
    //   - 읽기: 금지 (관리자만 콘솔에서 열람)
    //   - 삭제: 금지
    match /training_data/{docId} {
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow read: if false;
      allow delete: if false;
    }

    // ── 양재 경매 시세 요약 (전체 공용, 읽기 전용) ────────────
    //   market/yangjae_latest
    //   `functions/index.js` 의 `updateFlowerPrices` 가 하루 한 번 쓴다.
    //   Admin SDK 는 이 규칙을 우회하므로 클라이언트 쓰기는 전부 막는다.
    //
    //   읽기를 로그인 사용자로 제한하는 이유: 게스트 모드를 없앴으므로
    //   앱 사용자는 항상 로그인 상태다. 공개로 열면 서비스키로 뽑은
    //   데이터를 아무나 긁어갈 수 있다.
    match /market/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── 문의하기 (제안 및 피드백) ────────────────────────────
    //   `inquiry_service.dart` 가 쓴다. 앱 화면과 이 규칙은 **같은 내용**
    //   이어야 한다. 앱에서만 막으면 서버에 직접 요청해서 뚫을 수 있고,
    //   규칙에서만 막으면 앱이 '권한 없음' 으로 멈춘다.
    //
    //   | | 작성자 | 관리자 |
    //   |---|---|---|
    //   | 읽기 | 본인 글만 | 전부 |
    //   | 수정 | 접수 상태 + 카테고리·내용·첨부만 | 답변 칸만 |
    //   | 삭제 | 언제든 | 언제든 |
    //
    //   🔴 `hasOnly()` 로 바꿀 수 있는 칸을 못 박았다. 이게 없으면
    //      작성자가 자기 글의 `status` 를 '답변완료' 로 바꾸거나
    //      `answer` 에 아무 말이나 적어 넣을 수 있다.
    match /inquiries/{docId} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == '접수'
                    && request.resource.data.answer == ''
                    && request.resource.data.answeredAt == null
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 1000
                    && request.resource.data.get('attachmentUrls', []).size() <= 3;

      // 남의 글은 아예 읽히지 않는다.
      allow read: if isOwner(resource.data.uid) || isAdmin();

      allow update: if
        // (가) 작성자가 고치는 경우 — 답변 전에만, 내용 칸만.
        (
          isOwner(resource.data.uid)
          && resource.data.status == '접수'
          && resource.data.get('answer', '') == ''
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['category', 'content',
                         'attachmentUrls', 'attachmentNames', 'updatedAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.get('attachmentUrls', []).size() <= 3
        )
        // (나) 관리자가 답변하는 경우 — 답변 칸만. 남의 글 내용은 못 바꾼다.
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['answer', 'answeredAt', 'status'])
        );

      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ── 그 외 모든 경로 차단 ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
