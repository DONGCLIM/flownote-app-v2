rules_version = '2';

// ════════════════════════════════════════════════════════════════
//  FlowNote Firestore 보안 규칙
//
//  ⚠️ 배포 방법 (둘 중 하나)
//   A) Firebase 콘솔 → Firestore Database → 규칙 탭 → 이 내용 붙여넣고 [게시]
//   B) CLI:  firebase deploy --only firestore:rules
//
//  ⚠️ 중요: `training_data` 컬렉션은 OCR 학습데이터 수집용으로
//     기존 앱이 **인증 없이도** 쓰고 있었다. 아래 규칙은 로그인 사용자에게만
//     쓰기를 허용하도록 조인다. (게스트 모드를 없앴으므로 항상 로그인 상태)
// ════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── 헬퍼 ────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // 게스트(익명) 로그인인가. (#192)
    //
    // 🔴 Firebase 익명 로그인도 `request.auth != null` 이다. 그래서
    //    "로그인했으면 통과" 규칙은 **게스트도 전부 통과시킨다.**
    //    게스트는 가입 절차가 없어 누구인지 알 수 없고, 앱을 지웠다
    //    깔면 새 계정이 무한정 만들어진다. 공용 컬렉션에 그대로 열어
    //    두면 아무나 쓰레기를 쌓을 수 있다.
    function isAnon() {
      return isSignedIn()
             && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    /// 정식 가입자(게스트 아님).
    function isMember() {
      return isSignedIn() && !isAnon();
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 게스트가 자기 uid 아래에 쓰는 것만 허용한다. (#192)
    //
    // 🔴 사장님 지시(#192): "익명 사용자는 users/{자기 uid} 아래에는
    //    쓸 수 있고, 그 외에는 아무것도 쓸 수 없게".
    function isOwnerMember(uid) {
      return isOwner(uid) && isMember();
    }

    // 게스트 체험 한도. 앱(`GuestLimits`)과 **같은 값**이어야 한다. (#192)
    //
    // 🔴 앱에서만 막으면 서버에 직접 요청해 뚫을 수 있다. 규칙에서도
    //    못 박아야 진짜 한도다.
    function guestScanMax() { return 5; }
    function guestPdfMax()  { return 3; }

    // 관리자 한 명.
    //
    // 🔴 `inquiry_service.dart` 의 `adminEmail` 과 **같은 주소**여야 한다.
    //    한쪽만 바꾸면 앱에는 답변 버튼이 보이는데 저장이 거부된다.
    //
    // 🔴 `email_verified` 를 같이 본다. 메일 주소만 보면, 확인되지 않은
    //    주소로 가입해 관리자 행세를 할 여지가 생긴다.
    function isAdmin() {
      return isSignedIn()
             && request.auth.token.email == 'flownote.kr@gmail.com'
             && request.auth.token.email_verified == true;
    }

    // ── 사용자 개인정보 ──────────────────────────────────────
    //   users/{uid}                  회원 정보 + 사업자 정보 + 동의 이력
    //   users/{uid}/receipts/{id}    영수증 클라우드 백업
    //   users/{uid}/purchase_lists/{id} 사입 리스트 PC↔폰 동기화 (#191)
    //   users/{uid}/consent_log/{id} 동의 이력 감사 로그 (append-only)
    //
    //   본인만 읽고 쓸 수 있다. 다른 사용자의 문서는 절대 접근 불가.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);   // 회원 탈퇴

      match /receipts/{receiptId} {
        allow read, write: if isOwner(uid);
      }

      // ── 게스트 체험 사용 횟수 (#192) ───────────────────────
      //   users/{uid}/usage/counters  { scans: 0, pdfs: 0 }
      //
      //   🔴 왜 서버에 두나 — 예전에는 `SharedPreferences` 에만 적었다.
      //      앱을 지웠다 깔면 0 으로 돌아가고, 기기에서 고칠 수도 있다.
      //      체험 한도는 서버가 지켜야 한다.
      //
      //   🔴 게스트는 **한 번에 1씩만** 올릴 수 있고 한도를 못 넘는다.
      //      사장님 지시(#192). 한 번에 여러 개를 올리거나 되돌리는
      //      요청은 거부된다.
      match /usage/{docId} {
        allow read: if isOwner(uid);

        // 처음 만들 때는 0 또는 1 에서 시작한다.
        allow create: if isOwner(uid)
                      && request.resource.data.scans is int
                      && request.resource.data.pdfs is int
                      && request.resource.data.scans >= 0
                      && request.resource.data.pdfs >= 0
                      && request.resource.data.scans <= 1
                      && request.resource.data.pdfs <= 1;

        // 가입자는 자유롭게. 게스트는 1씩, 한도까지만.
        allow update: if isOwnerMember(uid)
                      || (
                        isOwner(uid)
                        && request.resource.data.scans is int
                        && request.resource.data.pdfs is int
                        && request.resource.data.scans <= guestScanMax()
                        && request.resource.data.pdfs <= guestPdfMax()
                        // 되돌리거나 건너뛸 수 없다. 그대로이거나 +1.
                        && request.resource.data.scans
                             >= resource.data.scans
                        && request.resource.data.scans
                             <= resource.data.scans + 1
                        && request.resource.data.pdfs
                             >= resource.data.pdfs
                        && request.resource.data.pdfs
                             <= resource.data.pdfs + 1
                      );

        allow delete: if isOwner(uid);
      }

      // 사입 리스트 PC↔폰 동기화 (#191)
      //
      // 🔴 아래 `{document=**}` 포괄 규칙으로도 통과하긴 했지만, 명시해
      //    둔다. 포괄 규칙은 나중에 조일 때 제일 먼저 지워지는 자리라,
      //    그때 사입 리스트까지 같이 막히면 원인을 찾기 어렵다.
      //
      // 🔴 본인 것만. 남의 uid 아래는 읽지도 쓰지도 못한다.
      //    담기는 것: 날짜·목적·한도·품목(체크 포함)·메모·스케치 좌표.
      match /purchase_lists/{listId} {
        allow read, write: if isOwner(uid);
      }

      // 동의 이력은 수정/삭제 금지 (법적 증빙) — 단, 탈퇴 시 삭제는 허용
      match /consent_log/{logId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // 그 밖의 하위 컬렉션도 본인만
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── OCR 학습데이터 (기존 기능 유지) ──────────────────────
    //   training_data/{docId}
    //   `training_data_service.dart` 가 스캔 시점에 기록한다.
    //   - 생성/수정: 로그인 사용자
    //   - 읽기: 금지 (관리자만 콘솔에서 열람)
    //   - 삭제: 금지
    //   🔴 게스트는 쓸 수 없다(#192). 익명 계정은 앱을 지웠다 깔면 얼마든지
    //      새로 만들어져서, 열어 두면 학습 데이터가 쓰레기로 덮인다.
    match /training_data/{docId} {
      allow create: if isMember();
      allow update: if isMember();
      allow read: if false;
      allow delete: if false;
    }

    // ── 양재 경매 시세 요약 (전체 공용, 읽기 전용) ────────────
    //   market/yangjae_latest
    //   `functions/index.js` 의 `updateFlowerPrices` 가 하루 한 번 쓴다.
    //   Admin SDK 는 이 규칙을 우회하므로 클라이언트 쓰기는 전부 막는다.
    //
    //   읽기를 로그인 사용자로 제한하는 이유: 게스트 모드를 없앴으므로
    //   앱 사용자는 항상 로그인 상태다. 공개로 열면 서비스키로 뽑은
    //   데이터를 아무나 긁어갈 수 있다.
    //   🔴 읽기는 게스트에게도 연다(#192). 홈 화면에 시세 줄이 있는데
    //      막으면 체험 중에 빈 칸이 보인다. 쓰기는 여전히 전부 금지다.
    match /market/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── 문의하기 (제안 및 피드백) ────────────────────────────
    //   `inquiry_service.dart` 가 쓴다. 앱 화면과 이 규칙은 **같은 내용**
    //   이어야 한다. 앱에서만 막으면 서버에 직접 요청해서 뚫을 수 있고,
    //   규칙에서만 막으면 앱이 '권한 없음' 으로 멈춘다.
    //
    //   | | 작성자 | 관리자 |
    //   |---|---|---|
    //   | 읽기 | 본인 글만 | 전부 |
    //   | 수정 | 접수 상태 + 카테고리·내용·첨부만 | 답변 칸만 |
    //   | 삭제 | 언제든 | 언제든 |
    //
    //   🔴 `hasOnly()` 로 바꿀 수 있는 칸을 못 박았다. 이게 없으면
    //      작성자가 자기 글의 `status` 를 '답변완료' 로 바꾸거나
    //      `answer` 에 아무 말이나 적어 넣을 수 있다.
    match /inquiries/{docId} {
      // 🔴 게스트는 글을 쓸 수 없다(#192). 답변을 보낼 곳이 없고,
      //    앱 프로필에서도 '가입 후' 로 잠가 두었다. 두 곳이 같아야 한다.
      allow create: if isMember()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == '접수'
                    && request.resource.data.answer == ''
                    && request.resource.data.answeredAt == null
                    && request.resource.data.content is string
                    && request.resource.data.content.size() > 0
                    && request.resource.data.content.size() <= 1000
                    && request.resource.data.get('attachmentUrls', []).size() <= 3;

      // 남의 글은 아예 읽히지 않는다.
      allow read: if isOwner(resource.data.uid) || isAdmin();

      allow update: if
        // (가) 작성자가 고치는 경우 — 답변 전에만, 내용 칸만.
        (
          isOwner(resource.data.uid)
          && resource.data.status == '접수'
          && resource.data.get('answer', '') == ''
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['category', 'content',
                         'attachmentUrls', 'attachmentNames', 'updatedAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 1000
          && request.resource.data.get('attachmentUrls', []).size() <= 3
        )
        // (나) 관리자가 답변하는 경우 — 답변 칸만. 남의 글 내용은 못 바꾼다.
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['answer', 'answeredAt', 'status'])
        );

      allow delete: if isOwner(resource.data.uid) || isAdmin();
    }

    // ── 그 외 모든 경로 차단 ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
